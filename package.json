{
  "name": "github-releases-feed",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "types": "pnpm types:typescript; pnpm types:svelte",
    "types:typescript": "tsc --noEmit",
    "types:svelte": "svelte-check --output=human",
    "lint": "pnpm lint:oxlint; pnpm lint:eslint",
    "lint:oxlint": "oxlint *.ts src/**/*.{ts,svelte} tests/**/*.ts",
    "lint:eslint": "eslint --concurrency=auto *.ts src/**/*.{ts,svelte} tests/**/*.ts",
    "format": "oxfmt index.html *.{html,js,ts,json,md} src/**/*.{css,js,ts,svelte} tests/**/*.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@octokit/core": "7.0.8",
    "@octokit/graphql": "9.0.5",
    "@octokit/request-error": "7.1.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.10.0",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-svelte": "3.23.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "idb": "8.0.3",
    "jsdom": "30.0.1",
    "lightningcss": "1.33.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "tslib": "2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
