{
  "name": "github-releases-feed",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "types": "pnpm types:typescript; pnpm types:svelte",
    "types:typescript": "tsc --noEmit",
    "types:svelte": "svelte-check --output=human",
    "lint": "pnpm lint:oxlint; pnpm lint:eslint",
    "lint:oxlint": "oxlint *.ts src/**/*.{ts,svelte}",
    "lint:eslint": "eslint --concurrency=auto *.ts src/**/*.{ts,svelte}",
    "format": "oxfmt index.html *.{html,js,ts,json,md} src/**/*.{css,js,ts,svelte}"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@octokit/core": "7.0.6",
    "@octokit/graphql": "9.0.3",
    "@octokit/request-error": "7.1.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tsconfig/svelte": "5.0.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.6.0",
    "eslint-plugin-oxlint": "1.73.0",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "idb": "8.0.3",
    "jsdom": "29.1.1",
    "lightningcss": "1.32.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "svelte-eslint-parser": "1.8.0",
    "tslib": "2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
