{
  "name": "github-releases-feed",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "types": "pnpm types:typescript; pnpm types:svelte",
    "types:typescript": "tsc --noEmit",
    "types:svelte": "svelte-check --output=human",
    "lint": "pnpm lint:oxlint; pnpm lint:eslint",
    "lint:oxlint": "oxlint *.ts src/**/*.{ts,svelte}",
    "lint:eslint": "eslint --concurrency=auto *.ts src/**/*.{ts,svelte}",
    "format": "oxfmt index.html *.{html,js,ts,json,md} src/**/*.{css,js,ts,svelte}"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@octokit/core": "7.0.6",
    "@octokit/graphql": "9.0.3",
    "@octokit/request-error": "7.1.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tsconfig/svelte": "5.0.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-oxlint": "1.76.0",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.8.0",
    "idb": "8.0.3",
    "jsdom": "30.0.1",
    "lightningcss": "1.33.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "svelte-eslint-parser": "1.8.0",
    "tslib": "2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
